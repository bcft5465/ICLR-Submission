if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--model", required=True,
        choices=list(LOCAL_DIRS.keys()) + ["all"],
    )
    parser.add_argument(
        "--prompt_mode", default="standard",
        choices=["standard", "cot"],
    )
    parser.add_argument(
        "--recalibrate", action="store_true", default=True,
    )
    parser.add_argument(
        "--no_recalibrate", dest="recalibrate", action="store_false",
    )
    args = parser.parse_args()

    keys = list(LOCAL_DIRS.keys()) if args.model == "all" else [args.model]
    for k in keys:
        print(f"\n{'='*60}")
        print(f"  Model: {k}  |  Prompt: {args.prompt_mode}  |  "
              f"Recalibrate: {args.recalibrate}")
        print(f"{'='*60}")
        if k == "biovil_t":
            run_biovil_t(recalibrate=args.recalibrate)
        elif k == "llama":
            run_llama_transformers(
                prompt_mode=args.prompt_mode,
                recalibrate=args.recalibrate,
            )
        else:
            run_vllm(
                model_key=k,
                prompt_mode=args.prompt_mode,
                recalibrate=args.recalibrate,
            )

