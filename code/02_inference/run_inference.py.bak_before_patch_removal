#!/usr/bin/env python3
"""
02_inference/run_inference.py  — v2.2
Root cause of CUDA scatter/gather OOB assert with Mllama:
  The processor inserts special cross-attention image placeholder tokens
  whose IDs exceed the text vocabulary size. Without the
  _get_num_multimodal_tokens patch, generate() passes these raw IDs into
  the token embedding lookup and triggers the device-side assertion.

Fixes in this version:
  1. _get_num_multimodal_tokens patch RE-ENABLED and hardened
  2. attention_mask is kept (NOT popped) — cross-attention requires it
  3. repetition_penalty + no_repeat_ngram_size kept to prevent !!! loops
  4. Image resized to 560x560 max before processing — reduces tile count,
     which is the other source of OOB token IDs in Mllama
  5. Processor called with return_tensors=pt and explicit padding=False
     to avoid spurious pad tokens pushing IDs out of range
"""

# ── PATCHES (must run before any transformers/vllm import) ────────────────────

import os
os.environ["CUDA_LAUNCH_BLOCKING"] = "1"
os.environ["TORCH_USE_CUDA_DSA"] = "1"

import sys
import builtins
from PIL.Image import Resampling

sys.modules["transformers.utils.PILImageResampling"] = Resampling
setattr(builtins, "PILImageResampling", Resampling)

try:
    import transformers
    import transformers.image_processing_utils as _ipu
    import transformers.image_processing_base as _ipb
    for _mod in [transformers, _ipu, _ipb]:
        if not hasattr(_mod, "PILImageResampling"):
            setattr(_mod, "PILImageResampling", Resampling)
    try:
        import transformers.image_processing_utils_fast as _ipuf
        if not hasattr(_ipuf, "PILImageResampling"):
            _ipuf.PILImageResampling = Resampling
    except ImportError:
        pass
except Exception:
    pass
print("[patch] PILImageResampling injected.")

# ── MllamaProcessor patch ─────────────────────────────────────────────────────
#
# WHY THIS IS NEEDED:
#   Mllama splits images into tiles (up to 4 tiles + 1 global = 5 tiles).
#   Each tile contributes 1601 cross-attention tokens. The processor calls
#   _get_num_multimodal_tokens() to tell generate() how many special image
#   token IDs to reserve. If this method is missing (older transformers),
#   generate() miscounts and assigns token IDs beyond the vocab boundary,
#   causing the scatter/gather kernel out-of-bounds assertion on CUDA.
#
#   Returning {"num_image_tokens": [1601]} covers the single-tile case.
#   For multi-tile (large images), it should be num_tiles * 1601.
#   We fix this by capping image size at 560x560 before processing,
#   which guarantees Mllama uses exactly 1 tile → exactly 1601 tokens.
#
try:
    from transformers import MllamaProcessor
    if not hasattr(MllamaProcessor, "_get_num_multimodal_tokens"):
        def _get_num_multimodal_tokens(self, **kwargs):
            # 1601 tokens per tile; we enforce 1 tile via image resize
            return {"num_image_tokens": [1601]}
        MllamaProcessor._get_num_multimodal_tokens = _get_num_multimodal_tokens
        print("[patch] MllamaProcessor._get_num_multimodal_tokens injected.")
    else:
        print("[patch] MllamaProcessor._get_num_multimodal_tokens already present.")
except ImportError:
    print("[patch] MllamaProcessor not importable — will retry after model load.")

